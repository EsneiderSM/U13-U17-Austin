<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="AdagetechCS" value="https://nuget.cloudsmith.io/adage-tech/adage/v3/index.json" />
  </packageSources>
  <!-- Migration: every package referenced by the solution is on nuget.org; map them there so restore
       does not fail when the private AdagetechCS feed is unreachable (401). -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <activePackageSource>
    <add key="All" value="(Aggregate source)" />
  </activePackageSource>
</configuration>
