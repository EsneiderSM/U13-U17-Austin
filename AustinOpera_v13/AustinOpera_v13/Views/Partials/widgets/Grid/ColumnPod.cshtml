@inherits UmbracoViewPage<BlockListItem>
@using Umbraco.Cms.Core.Models.Blocks;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using AustinOpera_v13.Helpers;
@{
    var content = (ContentModels.ColumnPod)Model.Content;
    var settings = (ContentModels.ColumnPodSettings)Model.Settings;
    var iconImage = settings.Value<bool>("iconImage");
    var imageAltText = AdageHtmlHelper.GetAltText(content.Image, content.Heading);
    var contentSite = Context.Request.Scheme + "://" + Context.Request.Host;
    var imageUrl = AdageHtmlHelper.GetAbsoluteUrlFromString(content.Image?.Url()!, contentSite);
}

<div class="grid-item grid-item--pod pod @(settings.BoxedColumn ? "grid-item--boxed" : "") @(settings.CenterContent ? "text-center" : "" ) @(settings.PodMediaLeft ? "pod--compact" : "")">
    <article>
        @if (!string.IsNullOrWhiteSpace(content.Icon) || content.Image != null)
        {
            <div class="pod__image @(iconImage ? "pod__image--icon" : "")">
                @if (content.Link != null)
                {
                    <a href="@AdageHtmlHelper.GetAbsoluteUrl(content.Link, contentSite)" target="@content.Link.Target" title="@content.Heading">
                        @if (!string.IsNullOrWhiteSpace(content.Icon))
                        {
                            <i class="fa @(content.Icon)" aria-hidden="true"></i>
                        }
                        else
                        {
                            <img class="lazyload"
                                 src="@(imageUrl)?width=10"
                                 data-sizes="auto"
                                 data-srcset="@(imageUrl)?upscale=false&width=300&quality=80 300w,
                        	    @(imageUrl)?upscale=false&width=500&quality=80 500w,
                        	    @(imageUrl)?upscale=false&width=750&quality=80 750w,
                        	    @(imageUrl)?upscale=false&width=1000&quality=80 1000w"
                                 alt="@imageAltText">
                        }
                    </a>
                }
                else
                {
                    if (!string.IsNullOrWhiteSpace(content.Icon))
                    {
                        <i class="fa @(content.Icon)" aria-hidden="true"></i>
                    }
                    else
                    {
                        <img class="lazyload"
                             src="@(imageUrl)?width=10"
                             data-sizes="auto"
                             data-srcset="@(imageUrl)?upscale=false&width=300&quality=80 300w,
                    	    @(imageUrl)?upscale=false&width=500&quality=80 500w,
                    	    @(imageUrl)?upscale=false&width=750&quality=80 750w,
                    	    @(imageUrl)?upscale=false&width=1000&quality=80 1000w"
                             alt="@imageAltText">
                    }
                }
            </div>
        }
        <div class="pod__text">
            @if (content.Link != null)
            {
                <h3 class="h5"><a href="@AdageHtmlHelper.GetAbsoluteUrl(content.Link, contentSite)" target="@content.Link.Target" title="@content.Heading">@content.Heading</a></h3>
            }
            else
            {
                <h3 class="h5">@content.Heading</h3>
            }
            @Html.Raw(content.Text)

            @if (content.Buttons != null & content.Buttons.Any())
            {
                <div class="button-wrap">
                    @foreach (var button in content.Buttons)
                    {
                        @Html.Partial("~/Views/Partials/Widgets/RenderButton.cshtml", button)
                    }
                </div>
            }
        </div>
    </article>
</div>