{
  "compilerOptions": {
    "baseUrl": "./Static/typescript",
    "jsx": "react",
    "moduleResolution": "node",
    "noImplicitAny": false,
    "esModuleInterop": true,
    "paths": {
      "*": [
        "node_modules"
      ]
    },
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "es5"
  },
  "exclude": [
    "node_modules",
  ],
  "compileOnSave": false
}